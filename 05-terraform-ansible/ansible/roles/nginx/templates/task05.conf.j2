# Task 05 reverse proxy: public tier -> application tier.
#
# The upstream is the app's PRIVATE address in the apps VPC, reachable only
# because public and apps are peered. There is no route from here to the
# database tier at all, so even a misconfiguration cannot proxy to it.

upstream task05_app {
    server {{ hostvars['app']['ansible_host'] | default(app_private_ip) }}:{{ app_port }};
    keepalive 8;
}

server {
    # `http2 on;` as a separate directive is nginx 1.25.1+. Debian 12 ships
    # 1.22, where HTTP/2 is a parameter on the listen line. Using the newer
    # form fails with `unknown directive "http2"` - caught by `nginx -t` before
    # any reload, which is exactly why the playbook validates before reloading
    # rather than after.
    listen 443 ssl http2;
    server_name _;

    ssl_certificate     {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/task05.access.log;
    error_log  /var/log/nginx/task05.error.log warn;

    location / {
        proxy_pass http://task05_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    15s;
    }

    # nginx's own liveness, independent of the app, so the proxy tier can be
    # distinguished from the app tier when something is down.
    location = /nginx-health {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"ok","service":"nginx","tier":"public"}';
    }
}

# Port 80 is NOT opened. The firewall admits 443 only, so a listener here would
# be unreachable anyway, and "just for the redirect" is how plaintext ends up
# serving real traffic.
