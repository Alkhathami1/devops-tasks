# Copy to terraform.tfvars and fill in. terraform.tfvars is GITIGNORED:
# it can hold a real project id and, in other setups, real credentials.

project_id = "your-gcp-project-id"

# Generated by scripts/keygen.sh - the PUBLIC half only.
ssh_public_key = "ssh-ed25519 AAAA... ansible@task05"

# Lock this to your own address for anything longer-lived than a demo.
# admin_source_cidr = "203.0.113.4/32"

# region = "us-central1"
# zone   = "us-central1-a"
