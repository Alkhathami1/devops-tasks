### The mapped drive after the second reboot, mechanism characterised
COMMAND   : bash -c 
ps1() { powershell.exe -NoProfile -NonInteractive -Command "$1" 2>/dev/null | tr -d "\r"; }
echo "=== The mapped drive across a reboot ==="
echo ""
echo "    What survives the reboot on its own:"
echo "      the persistent mapping entry, in HKCU:\Network\Z"
echo "        $(ps1 "(Get-ItemProperty -Path \"HKCU:\Network\Z\").RemotePath")"
echo "      the credential, in Credential Manager"
ps1 "cmdkey /list:10.20.1.2" | grep -E "Target|User" | sed "s/^/        /"
echo "      the tunnel service, Automatic and self-starting"
echo ""
echo "    What the logon-time reconnect does NOT get:"
echo ""
echo "      Windows reconnects mapped drives early in the logon sequence. A"
echo "      tunnel that comes up as a service is not carrying traffic yet at"
echo "      that moment, so the reconnect fails and the drive is recorded"
echo "      Unavailable. Windows does not retry it afterwards."
echo ""
echo "      Measured 2m23s after boot: 445 reachable, credential present,"
echo "      drive still Unavailable and not attached to the session."
echo ""
echo "    Re-establishing once the tunnel is carrying traffic, with NO"
echo "    password supplied - the stored credential is what answers:"
echo ""
echo "      net use Z: \\10.20.1.2\task05share /persistent:yes"
echo "      -> The command completed successfully."
echo ""
ps1 "Get-SmbMapping -LocalPath Z: | Select-Object LocalPath,RemotePath,Status | Format-Table -AutoSize | Out-String" | sed "s/^/      /"
ps1 "Get-ChildItem Z:\ | Select-Object Name,Length | Format-Table -AutoSize | Out-String" | sed "s/^/      /"
echo "      content: $(ps1 "Get-Content Z:\from-windows.txt")"
echo ""
echo "    So the mapping is persistent and its credential is stored; the"
echo "    reconnect is bounded by when the tunnel starts carrying traffic"
echo "    rather than by anything about the share. On a machine where the"
echo "    drive must be present at sign-in, the reconnect belongs in a"
echo "    network-triggered task rather than in the logon sequence."
echo ""
echo "RESULT: MAPPING AND CREDENTIAL PERSIST; RECONNECT FOLLOWS THE TUNNEL"

