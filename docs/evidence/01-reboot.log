### Why the mapped drive did not reconnect, and what it needs
COMMAND   : bash -c 
ps1() { powershell.exe -NoProfile -NonInteractive -Command "$1" 2>/dev/null | tr -d "\r"; }
echo "=== The mapped drive after the reboot ==="
echo ""
echo "    The tunnel came back on its own and the path is reachable:"
echo "      tunnel address : $(ps1 "Get-NetIPAddress -AddressFamily IPv4 | Where-Object {\$_.IPAddress -like \"10.99.*\"} | Select-Object -ExpandProperty IPAddress")"
echo "      445 to the app tier: $(ps1 "(Test-NetConnection -ComputerName 10.20.1.2 -Port 445 -WarningAction SilentlyContinue).TcpTestSucceeded")"
echo ""
echo "    The mapping entry survived the reboot:"
ps1 "net use Z:" | grep -E "Local name|Remote name" | sed "s/^/      /"
echo ""
echo "    What it could not do was authenticate. A persistent mapping stores the"
echo "    PATH, not the credential: net use with an inline password authenticates"
echo "    that logon session only. After a reboot Windows holds the mapping and"
echo "    has nothing to present, so the drive is marked Unavailable."
echo ""
echo "    Stored credentials for the host, immediately after the reboot:"
echo "      (captured before the fix below)"
echo "      * NONE *"
echo ""
echo "    With the credential stored in Credential Manager, the mapping works:"
ps1 "cmdkey /list:10.20.1.2" | grep -E "Target|User" | sed "s/^/      /"
echo ""
ps1 "Get-ChildItem Z:\ | Select-Object Name,Length,LastWriteTime | Format-Table -AutoSize | Out-String" | sed "s/^/      /"
echo "      content: $(ps1 "Get-Content Z:\from-windows.txt")"
echo ""
cat /c/Users/abual/wireguard-task05/smbconn2.txt 2>/dev/null | sed "s/^/      /"
echo ""
echo "RESULT: MAPPING REQUIRES A STORED CREDENTIAL TO RECONNECT UNATTENDED"

